        }
      }
    },
    "Se borra tu usuario en el servidor y no se puede deshacer. Tus favoritos, que están en este iPhone, no se tocan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your user is deleted on the server and this cannot be undone. Your favourites, which live on this iPhone, are untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borra tu usuario en el servidor y no se puede deshacer. Tus favoritos, que están en este iPhone, no se tocan."
          }
        }
      }
    },
    "Se guardan solo en este dispositivo y no se pueden recuperar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They live on this device only and cannot be recovered."
