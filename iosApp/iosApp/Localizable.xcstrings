        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan solo en este dispositivo y no se pueden recuperar."
          }
        }
      }
    },
    "Se programan siete días por adelantado. iOS admite 64 notificaciones pendientes por app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven days are scheduled ahead. iOS allows 64 pending notifications per app."
