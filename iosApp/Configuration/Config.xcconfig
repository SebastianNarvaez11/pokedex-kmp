// Lo unico que cambia de un desarrollador a otro. TEAM_ID puede quedar vacio
// para el simulador; hace falta para instalar en un iPhone de verdad.
TEAM_ID=
BUNDLE_ID=com.sebastiannarvaez.pokedex
APP_NAME=Pokédex

// La version, que tiene que coincidir con la del catalogo de Gradle. Son dos
// ficheros porque son dos sistemas de compilacion distintos, pero el numero es
// el mismo: una version de la app es una version, no dos.
MARKETING_VERSION=1.0.0
CURRENT_PROJECT_VERSION=1

// Las claves de Supabase. Este fichero SÍ se versiona, así que se deja vacío:
// cada desarrollador pone las suyas en local y no las commitea.
//
// Ojo con las URL en un xcconfig: las dos barras de `https://` se interpretan
// como el comienzo de un comentario. Hay que escapar la segunda con `$()`:
//
//   SUPABASE_URL=https:/$()/abcdefgh.supabase.co
//
// Es de los errores más desconcertantes que hay, porque el valor llega
// truncado a `https:` sin que nada avise.
SUPABASE_URL=
SUPABASE_KEY=
