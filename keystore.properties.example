# Copia este fichero como `keystore.properties` y rellena los valores.
#
# `keystore.properties` y el propio `.jks` estan en .gitignore y **no se suben
# nunca**. Perder el almacen de claves de una app publicada significa no poder
# volver a actualizarla con la misma identidad: Play acepta una recuperacion
# solo si se uso Play App Signing, y App Store Connect ni eso.
#
# Se crea con:
#
#   keytool -genkeypair -v \
#     -keystore pokedex.jks -alias pokedex \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# 10000 dias son unos 27 anos. Play exige que la clave caduque despues del
# 22 de octubre de 2033, asi que una validez corta cierra la puerta a publicar.

RELEASE_STORE_FILE=pokedex.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=pokedex
RELEASE_KEY_PASSWORD=
