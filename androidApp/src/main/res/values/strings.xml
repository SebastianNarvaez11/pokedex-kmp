    <string name="favoritos_solo_local">Los favoritos se guardan solo en este dispositivo.</string>
    <!--
      Un plural de verdad, no un «(s)».

      El español y el inglés coinciden en tener solo `one` y `other`, así que
      esta entrada parece innecesaria. No lo es: el día que la app se traduzca
      al polaco o al ruso, que tienen `few` y `many`, el código no cambia. Y hay
      una trampa clásica: el `%d` hay que pasarlo **dos veces**, una para elegir
      la forma y otra para sustituirlo en el texto.
    -->
    <plurals name="favoritos_contados">
        <item quantity="one">%d favorito</item>
        <item quantity="other">%d favoritos</item>
    </plurals>

